LINGUASTACK_DATABASE_URL=postgres://linguastack:linguastack@localhost:5434/linguastack?sslmode=disable
LINGUASTACK_TEST_DATABASE_URL=postgres://linguastack:linguastack@localhost:5434/linguastack_test?sslmode=disable
# Ключ шифрования пользовательских API-ключей, 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
LINGUASTACK_SECRET_KEY=
LINGUASTACK_STORAGE_ROOT=./storage
LINGUASTACK_OLLAMA_BASE_URL=http://localhost:11434
LINGUASTACK_HTTP_ADDR=:8000
# По умолчанию true (cookie сессии только по HTTPS). false — только для
# локальной разработки по http.
LINGUASTACK_SESSION_COOKIE_SECURE=false
