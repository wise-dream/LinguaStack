# Настройки LinguaStack. Скопировать в .env рядом с этим файлом:
#   cp .env.example .env
# .env читают `make run-api` / `make run-worker` (разработка) и
# docker compose (развёртывание). Все переменные и значения по умолчанию —
# backend/internal/config/config.go, лимиты — docs/spec/SPEC-ADDENDUM.md §10.

# Ключ шифрования пользовательских API-ключей, 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
# Потеря ключа = потеря сохранённых ключей провайдеров (их придётся ввести заново).
LINGUASTACK_SECRET_KEY=

# --- разработка (процессы на хосте) ---
# По умолчанию true (cookie сессии только по HTTPS). false — только для
# локальной разработки по http. docker compose тоже берёт это значение:
# на сервере строку удалить.
LINGUASTACK_SESSION_COOKIE_SECURE=false
LINGUASTACK_DATABASE_URL=postgres://linguastack:linguastack@localhost:5434/linguastack?sslmode=disable
LINGUASTACK_TEST_DATABASE_URL=postgres://linguastack:linguastack@localhost:5434/linguastack_test?sslmode=disable
LINGUASTACK_STORAGE_ROOT=./storage
LINGUASTACK_OLLAMA_BASE_URL=http://localhost:11434
LINGUASTACK_HTTP_ADDR=:8000

# --- развёртывание (docker compose) ---
# Пароль БД применяется только при первом создании тома pgdata.
# LINGUASTACK_DB_PASSWORD=
# Порт api на 127.0.0.1 хоста (снаружи — через обратный прокси с TLS).
# LINGUASTACK_PUBLISH_PORT=8000
# Ollama, видимый из контейнера: на хосте он должен слушать не только
# 127.0.0.1 (OLLAMA_HOST=0.0.0.0, порт 11434 закрыт файрволом снаружи).
# LINGUASTACK_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- перевод ---
# Тайм-аут ответа модели. Для Ollama — время тишины в потоке ответа: долгая,
# но идущая генерация не обрывается.
# LINGUASTACK_PROVIDER_TIMEOUT=10m
# Размер батча. На CPU без видеокарты (единицы токенов в секунду) меньший
# батч быстрее показывает прогресс и меньше теряет при перезапуске.
# LINGUASTACK_MAX_BATCH_CHARS=6000
# Сколько после SIGTERM ждать начатый вызов модели (меньше stop_grace_period
# worker-а в docker-compose.yml).
# LINGUASTACK_WORKER_SHUTDOWN_GRACE=25s

# Разбор PDF: страниц в документе, время разбора, память модуля PDFium (МБ).
# LINGUASTACK_PDF_MAX_PAGES=2000
# LINGUASTACK_PDF_TIMEOUT=2m
# LINGUASTACK_PDF_MEMORY_MB=1024

# Экспорт: время сборки файла и одновременных экспортов на пользователя.
# LINGUASTACK_EXPORT_TIMEOUT=5m
# LINGUASTACK_MAX_ACTIVE_EXPORTS_PER_USER=3

# Частота запросов (0 — без ограничения): на пользователя в секунду и
# всплеск; загрузок книг на пользователя, регистраций и запросов сброса
# пароля с одного IP — в час.
# LINGUASTACK_RATE_LIMIT_RPS=20
# LINGUASTACK_RATE_LIMIT_BURST=60
# LINGUASTACK_UPLOADS_PER_HOUR=30
# LINGUASTACK_REGISTER_PER_HOUR=5
# LINGUASTACK_RESET_PER_HOUR=5
# Прокси, которым верится X-Forwarded-For (CIDR через запятую). За Docker
# и обратным прокси без этого все клиенты — один адрес моста.
# LINGUASTACK_TRUSTED_PROXIES=172.16.0.0/12

# Метрики Prometheus: GET /metrics у api только с заголовком
# «Authorization: Bearer <токен>»; без токена метрик нет. Worker отдаёт свои
# счётчики на отдельном адресе с тем же токеном (пусто — не отдаёт).
# Сгенерировать: openssl rand -hex 24
# LINGUASTACK_METRICS_TOKEN=
# LINGUASTACK_WORKER_METRICS_ADDR=:9101

# --- Telegram-бот (необязательно) ---
# Токен — от @BotFather; имя бота — для ссылок привязки (без @). Без них
# бот выключен. Адрес веб-приложения нужен для ссылок в сообщениях.
# LINGUASTACK_TELEGRAM_BOT_TOKEN=
# LINGUASTACK_TELEGRAM_BOT_USERNAME=
# LINGUASTACK_PUBLIC_URL=https://linguastack.example.com
